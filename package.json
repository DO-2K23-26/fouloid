{
  "name": "fouloid",
  "version": "1.0.0",
  "description": "Small TypeScript Node starter for fouloid",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#dummy": {
      "source": "./src/dummy/index.ts",
      "default": "./dist/dummy/index.js"
    }
  },
  "scripts": {
    "start": "node --env-file=.env --conditions=source --import tsx src/index.ts",
    "dev": "node --env-file=.env --conditions=source --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "@langchain/core": "^1.1.47",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.6",
    "apache-iggy": "0.8.1-edge.1",
    "langchain": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
