OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="openai/gpt-oss-20b:free"  # OpenRouter model id: "<provider>/<model>" — see https://openrouter.ai/models
OPENAI_API_KEY="changeme"          # paste your OpenRouter key here
IGGY_ADDRESS="127.0.0.1:8090"  # overridden to iggy:8090 inside Docker
IGGY_STREAM="agents"
IGGY_INPUT_TOPIC="agent-input"
IGGY_OUTPUT_TOPIC="agent-output"
AGENT_NAME="langchain-agent"
HEALTH_PORT="8080"
# AGENT_KICKOFF="Hello, who's there?"  # if set, the agent publishes this text once on startup

