{
  "title": "Fouloid Chat",
  "uid": "fouloid-chat",
  "tags": ["fouloid"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "agent",
        "type": "query",
        "label": "Agent",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({namespace=~\"gen.*|fulloid\"}, agent)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Messages entre fouloids",
      "description": "Chaque ligne = un message envoyé par un agent sur iggy. Format : [nom (genN)] message",
      "type": "logs",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"gen.*|fulloid\"} | json | action=\"iggy_send\" | agent=~\"$agent\" | line_format \"[{{.agent}} gen{{.generation}}]  {{.text}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 2,
      "title": "Pensées (think) — raisonnement avant d'agir",
      "type": "logs",
      "gridPos": { "x": 0, "y": 20, "w": 14, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"gen.*|fulloid\"} | json | action=\"think\" | agent=~\"$agent\" | line_format \"[{{.agent}} gen{{.generation}}]  {{.thought}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 3,
      "title": "Spawns réussis",
      "type": "logs",
      "gridPos": { "x": 14, "y": 20, "w": 10, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"gen.*|fulloid\"} | json | action=\"tool_call\" | tool=\"spawn_child\" | agent=~\"$agent\" | line_format \"[{{.agent}}]  spawned {{.args}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 4,
      "title": "Erreurs outils",
      "type": "logs",
      "gridPos": { "x": 0, "y": 32, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"gen.*|fulloid\"} | json | action=\"tool_error\" | agent=~\"$agent\" | line_format \"[{{.agent}} gen{{.generation}}] ERROR {{.tool}}: {{.error}}\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Ascending",
        "dedupStrategy": "none"
      }
    }
  ]
}
