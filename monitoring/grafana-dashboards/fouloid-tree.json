{
  "title": "Fouloid Genealogy Tree",
  "uid": "fouloid-tree",
  "tags": ["fouloid"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Agents actifs",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(kube_deployment_status_replicas_available{namespace=~\"gen.*|fulloid\"} > 0)",
          "legendFormat": "Live"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 2,
      "title": "Namespaces créés",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(kube_namespace_labels{label_fouloid_io_agent=\"true\"})",
          "legendFormat": "Total"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "value": 0, "color": "blue" }] },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 3,
      "title": "Génération max",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max(count by (label_fouloid_io_generation) (kube_namespace_labels{label_fouloid_io_agent=\"true\"}))",
          "legendFormat": "Max"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{ "value": 0, "color": "purple" }] },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 4,
      "title": "Par génération",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count by (label_fouloid_io_generation) (kube_namespace_labels{label_fouloid_io_agent=\"true\"})",
          "legendFormat": "Gen {{label_fouloid_io_generation}}"
        }
      ],
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    },

    {
      "id": 5,
      "title": "Arbre Généalogique — Graphe de nœuds",
      "description": "Chaque cercle = un fouloid. Les liens = relations parent→enfant. La couleur = génération.",
      "type": "nodeGraph",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "nodes",
          "expr": "label_replace(label_replace(label_replace(label_replace(kube_namespace_labels{label_fouloid_io_agent=\"true\"}, \"id\", \"$1\", \"namespace\", \"(.*)\"), \"title\", \"$1\", \"label_fouloid_io_word\", \"(.*)\"), \"mainStat\", \"$1\", \"label_fouloid_io_generation\", \"(.*)\"), \"detail__parent\", \"$1\", \"label_fouloid_io_parent\", \"(.*)\")",
          "instant": true,
          "legendFormat": "__auto"
        },
        {
          "refId": "edges",
          "expr": "label_join(label_replace(label_replace(kube_namespace_labels{label_fouloid_io_agent=\"true\", label_fouloid_io_parent!=\"\"}, \"source\", \"$1\", \"label_fouloid_io_parent\", \"(.*)\"), \"target\", \"$1\", \"namespace\", \"(.*)\"), \"id\", \">\", \"source\", \"target\")",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "mode": "columns" }
        }
      ],
      "options": {
        "nodes": {
          "mainStatUnit": "short",
          "secondaryStatUnit": "short",
          "arcs": []
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },

    {
      "id": 6,
      "title": "Liste des agents",
      "type": "table",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_namespace_labels{label_fouloid_io_agent=\"true\"}",
          "instant": true,
          "legendFormat": "__auto",
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "namespace": true,
              "label_fouloid_io_generation": true,
              "label_fouloid_io_word": true,
              "label_fouloid_io_parent": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "label_fouloid_io_generation": "Génération",
              "label_fouloid_io_word": "Mot",
              "label_fouloid_io_parent": "Parent"
            }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": [{ "displayName": "Génération", "desc": false }] }
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Génération" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    { "value": 0, "color": "green" },
                    { "value": 5, "color": "yellow" },
                    { "value": 10, "color": "orange" },
                    { "value": 15, "color": "red" }
                  ]
                }
              },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          }
        ]
      }
    },

    {
      "id": 7,
      "title": "Spawns au fil du temps",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agent) (count_over_time({namespace=~\"gen.*|fulloid\"} | json | action=\"tool_call\" | tool=\"spawn_child\" [1m]))",
          "legendFormat": "{{agent}}"
        }
      ],
      "options": { "tooltip": { "mode": "multi" } }
    }
  ]
}
