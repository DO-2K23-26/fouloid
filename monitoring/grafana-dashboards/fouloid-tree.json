{
  "title": "Fouloid Genealogy Tree",
  "uid": "fouloid-tree",
  "tags": ["fouloid"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Arbre Généalogique des Fouloid",
      "type": "nodeGraph",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "nodes",
          "expr": "kube_namespace_labels{label_fouloid_io_agent=\"true\"}",
          "legendFormat": "__auto",
          "instant": true
        },
        {
          "refId": "live",
          "expr": "kube_deployment_status_replicas_available{namespace=~\"gen.*|fulloid\"}",
          "legendFormat": "__auto",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "valueLabel": "namespace",
            "mode": "rows"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "label_fouloid_io_generation": "detail__Generation",
              "label_fouloid_io_word": "title",
              "label_fouloid_io_parent": "detail__Parent",
              "namespace": "id"
            }
          }
        }
      ],
      "options": {
        "nodes": {
          "mainStatUnit": "short",
          "secondaryStatUnit": "short"
        }
      }
    },
    {
      "id": 2,
      "title": "Agents actifs",
      "type": "stat",
      "gridPos": { "x": 0, "y": 20, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(kube_deployment_status_replicas_available{namespace=~\"gen.*|fulloid\"} > 0)",
          "legendFormat": "Live"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 3,
      "title": "Générations déployées",
      "type": "stat",
      "gridPos": { "x": 6, "y": 20, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "count(kube_namespace_labels{label_fouloid_io_agent=\"true\"})",
          "legendFormat": "Total"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Liste des agents",
      "type": "table",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "kube_namespace_labels{label_fouloid_io_agent=\"true\"}",
          "instant": true,
          "legendFormat": "__auto"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "mode": "rows" }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "namespace": true,
              "label_fouloid_io_generation": true,
              "label_fouloid_io_word": true,
              "label_fouloid_io_parent": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "label_fouloid_io_generation": "Génération",
              "label_fouloid_io_word": "Mot",
              "label_fouloid_io_parent": "Parent"
            }
          }
        }
      ]
    }
  ]
}
